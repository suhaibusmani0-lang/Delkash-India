# Delkash Associates Environment Configuration Template
# Copy this file to .env.local and populate with your credentials

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/delkash_db?retryWrites=true&w=majority

# Cloudinary Integration (Image Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# SMTP Email Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=delkashassociates@gmail.com
SMTP_PASS=your_16_char_google_app_password
LEAD_RECEIVER_EMAIL=advocate.rahimullah@gmail.com
